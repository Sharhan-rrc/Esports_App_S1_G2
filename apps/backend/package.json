{
  "name": "@esports/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "db:setup": "tsx prisma/prepare.ts && prisma generate && prisma migrate deploy && prisma db seed",
    "db:migrate": "tsx prisma/prepare.ts && prisma migrate dev",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "tsx": "^4.20.6",
    "@types/express": "^5.0.5",
    "@types/cors": "^2.8.19"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
