generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model Game {
  id Int @id @default(autoincrement())
  name String @unique
  genre String
  topPlayer String
  scores Score[]
  streams Stream[]
}
model Player {
  id Int @id @default(autoincrement())
  nameKey String @unique
  name String
  scores Score[]
}
model Score {
  id Int @id @default(autoincrement())
  gameId Int
  playerId Int
  score Float
  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)
  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
  @@unique([gameId, playerId])
}

model Stream {
  id Int @id @default(autoincrement())
  gameId Int
  title String
  platform String
  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)
  @@unique([gameId, title, platform])
}
