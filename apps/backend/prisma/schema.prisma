generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Game {
  id Int @id @default(autoincrement())
  name String @unique
  genre String
  topPlayer String
  scores Score[]
}
model Player {
  id Int @id @default(autoincrement())
  nameKey String @unique
  name String
  scores Score[]
}
model Score {
  id Int @id @default(autoincrement())
  gameId Int
  playerId Int
  score Float
  game Game @relation(fields: [gameId], references: [id], onDelete: NoAction)
  player Player @relation(fields: [playerId], references: [id], onDelete: NoAction)
  @@unique([gameId, playerId])
}
